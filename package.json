{
  "name": "cortex-enterprise-decision-intelligence-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server/dist",
    "lint": "tsc --noEmit",
    "server:dev": "npm --prefix server run dev",
    "server:build": "npm --prefix server run build",
    "server:start": "npm --prefix server run start",
    "server:lint": "npm --prefix server run lint",
    "db:generate": "npm --prefix server run prisma:generate",
    "db:migrate": "npm --prefix server run prisma:migrate",
    "db:seed": "npm --prefix server run prisma:seed",
    "neo4j:up": "docker --context default compose up -d neo4j",
    "intelligence:install": "cd intelligence && uv pip install -e . --no-deps",
    "intelligence:dev": "cd intelligence && .venv/bin/uvicorn cortex_intelligence.api.main:app --host 127.0.0.1 --port 8001 --reload",
    "intelligence:ingest": "cd intelligence && .venv/bin/python -m cortex_intelligence.cli ingest --mode full",
    "intelligence:test": "cd intelligence && .venv/bin/pytest -v"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
