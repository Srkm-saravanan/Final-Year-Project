# ==============================================================================
# CORTEX Enterprise Decision Intelligence Platform - Environment Template
# Copy this file to .env and fill in strong, unique values before starting.
# ==============================================================================

# --- PostgreSQL / Prisma ---
DATABASE_URL="postgresql://DB_USER:DB_PASSWORD@localhost:5432/cortex_db?schema=public"

# --- Backend Server ---
PORT=4000
NODE_ENV=development
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://localhost:4173,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:4173"
COOKIE_SECURE=false

# --- JWT Authentication ---
JWT_ACCESS_SECRET="replace-with-at-least-32-char-random-access-secret"
JWT_REFRESH_SECRET="replace-with-at-least-32-char-random-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# --- Initial Bootstrap Admin & Seed Passwords ---
BOOTSTRAP_ADMIN_NAME="Platform Administrator"
BOOTSTRAP_ADMIN_EMAIL="admin@cortex-enterprise.ai"
BOOTSTRAP_ADMIN_PASSWORD="replace-with-strong-initial-admin-password"
SEED_DEFAULT_USER_PASSWORD="replace-with-strong-seed-user-password"

# --- Frontend Vite Proxy (Development) ---
VITE_API_PROXY_TARGET="http://localhost:4000"

# --- Neo4j Knowledge Graph (Phase D1) ---
NEO4J_URI="bolt://localhost:7687"
NEO4J_HTTP_URL="http://localhost:7474"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="replace-with-strong-neo4j-password"
NEO4J_DATABASE="neo4j"

# --- Python FastAPI Intelligence Service (Phase D1) ---
INTELLIGENCE_HOST="127.0.0.1"
INTELLIGENCE_PORT=8001
INTELLIGENCE_SERVICE_URL="http://127.0.0.1:8001"
INTELLIGENCE_API_KEY="replace-with-strong-internal-service-key"
SYNTHETIC_RANDOM_SEED=20261112

# --- Local Ollama LLM Inference (Phase 1) ---
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="cortex-qwen:latest"
OLLAMA_CONTEXT_SIZE=4096
OLLAMA_TEMPERATURE=0.2
OLLAMA_TIMEOUT_SECONDS=60.0

# --- Reserved for Phase D2+ (Unused in Phase D1) ---
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="http://localhost:3000"
